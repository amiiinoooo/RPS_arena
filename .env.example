# Copy to .env and fill in. Never commit the real .env file.
# Long random string (64+ chars), e.g. python -c "import secrets; print(secrets.token_hex(48))"
RPS_FLASK_SECRET=
# IP the game server listens on / the web app and client connect to
RPS_BIND_HOST=127.0.0.1
RPS_SERVER_HOST=127.0.0.1
# Set to 1 when served over HTTPS
RPS_COOKIE_SECURE=0
